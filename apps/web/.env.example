# Entry Agents web runtime environment.
# Never commit real values. Production secrets belong in the Vercel project.

# ---------------------------------------------------------------------
# Required for the editor and agent runtime
# ---------------------------------------------------------------------
POSTGRES_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://entry-agents.dev
NEXT_PUBLIC_SITE_URL=https://entry-agents.dev

# Entry Gateway model routing. Required for every agent response.
GATEWAY_BASE_URL=
GATEWAY_API_KEY=

# boxd is the production Workspace provider.
# Use either BOXD_API_KEY or BOXD_TOKEN. BOXD_BASE_URL is only needed for
# a non-default boxd cluster.
BOXD_API_KEY=
BOXD_TOKEN=
BOXD_BASE_URL=

# ---------------------------------------------------------------------
# Sign-in providers
# ---------------------------------------------------------------------
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Optional GitHub repository features
# ---------------------------------------------------------------------
# Needed for repository cloning, GitHub App access, webhooks, commits and PRs.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Optional billing, rate limiting, automations and integrations
# ---------------------------------------------------------------------
BACHS_API_KEY=
BACHS_BASE_URL=
BACHS_WEBHOOK_SECRET=
BACHS_PRODUCT_IDS=
REDIS_URL=
KV_URL=
CRON_SECRET=
AUDIT_ROUTE_SECRET=
COMPOSIO_API_KEY=
# Enables the agent's web-search tool. Web fetch itself does not require this.
PARALLEL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Tool timeout overrides. Defaults are safe when omitted.
TOOL_TIMEOUT_BASH_MS=
TOOL_TIMEOUT_WEB_FETCH_MS=
