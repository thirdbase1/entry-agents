# Entry web app environment.
#
# Copy to `.env` and fill in. `.env*` is gitignored -- never commit real
# credentials. The server reads variables from the ambient environment
# (Next.js' built-in `.env` support); nothing else needs configuring.

# ---------------------------------------------------------------------
# Sandbox provider -- Modal (required)
# ---------------------------------------------------------------------
# Entry's sandbox provider is a registry plugin (packages/sandbox), and the
# default provider is Modal: a gVisor-isolated cloud sandbox whose workspace
# lives on a persistent Modal Volume mounted at /workspace.
#
# Without these, `isModalConfigured()` returns false and provisioning fails
# with "Modal is not configured: set MODAL_TOKEN_ID and MODAL_TOKEN_SECRET."
# -- it will NOT silently fall back to another provider.
#
# Create a token at https://modal.com/settings/tokens (or `modal token new`).
# Treat MODAL_TOKEN_SECRET like a password: it is shown only once.
#
# Cost reference for the chosen shape (https://modal.com/pricing): a 1 vCPU /
# 2 GiB sandbox plus a 1 GiB volume, billed per second with no idle charge.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Mount the persistent workspace Volume for every session.
#
# MUST be "true" for the design to hold. Modal's whole value here is that
# the filesystem survives sandbox expiry -- a session re-provisions and
# remounts the same bytes, which is why no workspace migration is needed
# (`MODAL_CAPABILITIES.workspaceMigration` is false). With this off, no
# volume is attached and every re-provision starts from an empty workspace.
#
# Off by default upstream; enabled here because it is the intended shape.
# Ignored on the hobby resource profile (see lib/deployment/resource-profile).
OPEN_AGENTS_SANDBOX_DRIVE=true

# ---------------------------------------------------------------------
# Auth -- Better Auth (required)
# ---------------------------------------------------------------------
# Secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_SITE_URL=

# OAuth client used for sign-in.
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# GitHub App used to clone repos into the sandbox.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------
# Neon Postgres connection string. Migrations run on `pnpm build`, and each
# preview deployment applies them against its own forked branch.
POSTGRES_URL=

# ---------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------
# Redis for the skills cache. Falls back to an in-process cache when unset.
REDIS_URL=
# or, on Vercel KV:
KV_URL=

# Shared secret for the scheduled audit route.
AUDIT_ROUTE_SECRET=

# Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
